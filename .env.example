# Vantyx LOI Handler — environment variable template
# Copy to .env and fill in your values (never commit .env to git).

SMTP_USER=sam@vantyx.com.au          # Your Google Workspace / Gmail address
SMTP_PASS=xxxx xxxx xxxx xxxx        # Gmail App Password (myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com             # Leave as-is for Gmail / Google Workspace
SMTP_PORT=587

LOI_RECIPIENT=sam@vantyx.com.au      # Inbox that receives LOI notifications
LOI_HOST=0.0.0.0                     # 0.0.0.0 to accept external connections
LOI_PORT=8080                        # Change if port is taken
