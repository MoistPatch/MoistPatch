# Vantyx LOI Handler — environment variable template
# Copy to .env and fill in your values (never commit .env to git).

SMTP_USER=sam@vantyx.com.au          # Your Google Workspace / Gmail address
SMTP_PASS=xxxx xxxx xxxx xxxx        # Gmail App Password (myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com             # Leave as-is for Gmail / Google Workspace
SMTP_PORT=587

LOI_RECIPIENT=sam@vantyx.com.au      # Inbox that receives LOI notifications
LOI_HOST=0.0.0.0                     # 0.0.0.0 to accept external connections
LOI_PORT=8080                        # Change if port is taken

# ── Marketing Agent ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxx        # console.anthropic.com/keys

# Meta (Facebook / Instagram) — developers.facebook.com
META_PAGE_ID=xxxx
META_PAGE_ACCESS_TOKEN=xxxx
INSTAGRAM_ACCOUNT_ID=xxxx           # Instagram Business account ID

# Twitter / X — developer.twitter.com
TWITTER_API_KEY=xxxx
TWITTER_API_SECRET=xxxx
TWITTER_ACCESS_TOKEN=xxxx
TWITTER_ACCESS_TOKEN_SECRET=xxxx

# LinkedIn — linkedin.com/developers
LINKEDIN_ORG_ID=xxxx                # Company page organisation ID
LINKEDIN_ACCESS_TOKEN=xxxx

# Google Ads — developers.google.com/google-ads/api
GOOGLE_ADS_DEVELOPER_TOKEN=xxxx
GOOGLE_ADS_ACCESS_TOKEN=xxxx        # OAuth 2.0 access token
GOOGLE_ADS_MANAGER_ACCOUNT_ID=xxxx  # MCC account ID
GOOGLE_ADS_CUSTOMER_ID=xxxx         # Advertiser account ID (e.g. 123-456-7890)
